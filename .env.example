# Base URL for the Inventory backend API (must include the /api/v1 segment).
#
# Dev default (leave unset): '/api/v1' is proxied to http://localhost:8080 by Vite.
# Point this at a deployed backend when not using the dev proxy, e.g.:
#   VITE_API_BASE_URL=https://inventory.example.com/api/v1
VITE_API_BASE_URL=/api/v1
